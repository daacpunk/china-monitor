# ─── China Monitor — environment variables ─────────────────────────────────
# Copy to .env for local dev. On Railway, set these in the service Variables tab.

# ── Database ──────────────────────────────────────────────────────────────
# Railway: leave UNSET locally; Railway's Postgres plugin auto-injects this.
# Local: optionally point to a local Postgres; otherwise the app falls back to
# embedded PGlite (./data.pgdata) — perfect for dev, zero setup.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── API keys (env-first; if unset, falls back to Settings page DB values) ──
# Recommended: set these as Railway secrets — never commit real keys.
# CEIC_API_KEY=      # Primary macro source (~9.9k subscribed CN/HK/TW series)
# SONAR_API_KEY=     # SAME value as your Perplexity API key. Powers the Policy
#                    # Tracker (/policy) live web/news/policy scans + research pulls.
# ANTHROPIC_API_KEY= # Claude synthesis: briefs, persona lenses, devil's-advocate red-team
# DEEPSEEK_API_KEY=  # Cheaper synthesis / classification alternative
# FRED_API_KEY=      # Free key from fred.stlouisfed.org/docs/api/api_key.html
#                   # Required for China CPI/PPI/IP/PMI fallback when NBS is unreachable

# ── AKShare sidecar (optional) ────────────────────────────────────────────
# URL of the Python AKShare service (separate Railway service) used for
# EastMoney-blocked endpoints. If unset, AKShare-backed series are skipped.
# AKSHARE_SIDECAR_URL=
# AKSHARE_TOKEN=       # Optional shared secret if the sidecar requires auth
