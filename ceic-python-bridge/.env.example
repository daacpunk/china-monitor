# ─────────────────────────────────────────────────────────────────────────────
# CEIC Python bridge — LOCAL ONLY.
#
# Copy to .env and fill in. This file must NEVER be committed, and these
# values must NEVER be entered into the China Monitor web UI, Railway, or any
# other hosted environment. The bridge is deliberately designed so your CEIC
# password stays on your own machine.
# ─────────────────────────────────────────────────────────────────────────────

# Your CEIC / CDMNext website login (the same one you use at ceicdata.com).
CEIC_LOGIN=
CEIC_PASSWORD=

# Used only by the low-level SessionsApi path. The official Ceic.login facade
# hardcodes application="CEIC_Python" itself, so you can leave this blank.
# Set it only if probe.py falls through to SessionsApi.login.
CEIC_APPLICATION=CEIC_Python

# ─── Upload target (only needed for `collector.py --post`) ───────────────────

# Base URL of your China Monitor deployment, no trailing slash.
CHINA_MONITOR_URL=https://your-app.up.railway.app

# Shared secret for POST /api/imports/ceic-bridge. This is NOT your CEIC
# password — generate a fresh random value and set the SAME value as the
# CEIC_IMPORT_TOKEN environment variable on Railway:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
CEIC_IMPORT_TOKEN=
