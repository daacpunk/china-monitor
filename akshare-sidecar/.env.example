# Copy to .env and fill in, then: docker compose up -d --build
#
# REQUIRED — shared secret. Must EXACTLY match AKSHARE_TOKEN on the main
# Railway service. Use a long random value, e.g.:  openssl rand -hex 32
AKSHARE_TOKEN=

# Optional — host port to expose (container always listens on 8000 internally).
# Change if 8000 is already in use on the VPS.
HOST_PORT=8000

# Optional — cache tuning. Defaults are 24h TTL / 500 entries.
AKSHARE_CACHE_TTL=86400
AKSHARE_CACHE_MAX=500
